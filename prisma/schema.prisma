generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DELETED

  @@map("analysis_status")
}

enum Platform {
  META
  TIKTOK
  LINKEDIN
  GENERAL

  @@map("platform")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  role          String        @default("member")
  tier          String        @default("trial")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  analyses      Analysis[]
  compareJobs   CompareJob[]
  usageRecords  UsageRecord[]

  @@map("users")
}


model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

enum CompareStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("compare_status")
}

model CompareJob {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  workspaceId String?       @map("workspace_id")
  status      CompareStatus @default(PROCESSING)
  platform    Platform
  winnerId    String?       @map("winner_id")
  results     Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  Analysis[]

  @@map("compare_jobs")
}

model Analysis {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  workspaceId  String?        @map("workspace_id")
  status       AnalysisStatus @default(PENDING)
  platform     Platform
  mediaType    MediaType      @default(IMAGE) @map("media_type")
  imageUrl     String         @map("image_url")
  results      Json?
  quotaCharged Boolean        @default(false) @map("quota_charged")
  compareJobId String?        @map("compare_job_id")
  shareToken   String?        @unique @map("share_token")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  compareJob   CompareJob?    @relation(fields: [compareJobId], references: [id], onDelete: SetNull)
  usageRecords UsageRecord[]

  @@map("analyses")
}

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  analysisId  String   @map("analysis_id")
  credits     Int
  chargedAt   DateTime @default(now()) @map("charged_at")
  refunded    Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}
